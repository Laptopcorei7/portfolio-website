# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template MUST ship: the README tells you to copy it, and it holds
# only variable names, never values.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw screenshot source (~8MB of full-res PNG/JPG). The processed 16:10 webp
# versions that the site actually serves live in public/projects/ and are
# committed. Keep the originals locally in case they need re-cropping.
/screenshots/

















.mcp.json

# Added by `vercel link`. It also appended a second `.env*` rule, which was
# removed: it sat *after* the `!.env.example` negation above and silently
# re-ignored the template the README tells you to copy.
.vercel
