# Your site's canonical origin, no trailing slash, e.g. https://hananiah.dev
# Used for Open Graph URLs, canonical links, sitemap.xml and robots.txt.
# Falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=

# Copy to .env.local and fill in. The contact form works without these — it
# logs submissions server-side instead of emailing — so you can leave them
# blank until you're ready to wire up real delivery.

# https://resend.com — free tier covers a portfolio contact form comfortably.
RESEND_API_KEY=

# Where contact form submissions get delivered.
CONTACT_TO_EMAIL=

# Must be a domain you've verified in Resend. Defaults to Resend's test sender
# (onboarding@resend.dev) when unset, which only delivers to your own account.
CONTACT_FROM_EMAIL=
